{
  "version": "1.0",
  "name": "NEXUS - Base de datos del mapa estelar",
  "design_principles": {
    "coordinate_system": "X|Y entero por mapa",
    "sector_key": "map_id:x:y",
    "storage_strategy": "sparse+chunks",
    "chunk_size": 32,
    "reason": "Permite mapas muy grandes sin guardar millones de sectores vacíos; se persisten sectores relevantes y/o chunks explorados.",
    "static_dynamic_split": {
      "static": [
        "tipo de sector",
        "cuerpo celeste",
        "depósitos base",
        "región",
        "efectos ambientales"
      ],
      "dynamic": [
        "naves",
        "colonias",
        "propietario",
        "recursos restantes",
        "anomalías temporales",
        "visibilidad",
        "eventos"
      ]
    }
  },
  "entities": {
    "maps": {
      "description": "Mapas o instancias espaciales.",
      "primary_key": "map_id",
      "fields": {
        "map_id": "int",
        "name": "string",
        "width": "int|null",
        "height": "int|null",
        "wrap_x": "bool",
        "wrap_y": "bool",
        "default_sector_type": "string",
        "is_active": "bool",
        "notes": "string"
      }
    },
    "regions": {
      "description": "Regiones/cuadrantes políticos o geográficos.",
      "primary_key": "region_id",
      "fields": {
        "region_id": "int",
        "map_id": "int",
        "name": "string",
        "short_name": "string",
        "min_x": "int",
        "max_x": "int",
        "min_y": "int",
        "max_y": "int",
        "color": "string",
        "owner_faction_id": "string|null",
        "owner_alliance_id": "string|null",
        "security_level": "int 0-5",
        "notes": "string"
      }
    },
    "sector_types": {
      "description": "Catálogo de terrenos/ambientes espaciales.",
      "primary_key": "sector_type_id",
      "fields": {
        "sector_type_id": "string",
        "name": "string",
        "category": "space|nebula|planet|asteroid|anomaly|station",
        "colonizable": "bool",
        "flight_cost_multiplier": "float",
        "evasion_modifier_pct": "float",
        "shield_modifier_pct": "float",
        "hull_damage_per_tick": "float",
        "crew_risk_pct": "float",
        "deuterium_density": "float",
        "visibility_modifier": "float",
        "hazards": "array[string]",
        "allowed_orbital_structures": "bool"
      }
    },
    "sectors": {
      "description": "Unidad mínima de la cartografía.",
      "primary_key": "sector_id",
      "fields": {
        "sector_id": "string map_id:x:y",
        "map_id": "int",
        "x": "int",
        "y": "int",
        "chunk_x": "int",
        "chunk_y": "int",
        "region_id": "int|null",
        "sector_type_id": "string",
        "name": "string|null",
        "colonizable": "bool",
        "celestial_body_id": "string|null",
        "colony_id": "string|null",
        "owner_player_id": "string|null",
        "owner_alliance_id": "string|null",
        "resource_nodes": "array[resource_node_ref]",
        "anomaly_ids": "array[string]",
        "structure_ids": "array[string]",
        "ship_ids": "array[string]",
        "base_flight_cost": "float",
        "current_flight_cost": "float",
        "last_updated_tick": "int"
      },
      "indexes": [
        [
          "map_id",
          "x",
          "y"
        ],
        [
          "map_id",
          "chunk_x",
          "chunk_y"
        ],
        [
          "region_id"
        ],
        [
          "sector_type_id"
        ],
        [
          "owner_alliance_id"
        ]
      ]
    },
    "celestial_bodies": {
      "description": "Planetas/campos de asteroides/esferas Dyson y otros cuerpos.",
      "primary_key": "celestial_body_id",
      "fields": {
        "celestial_body_id": "string",
        "sector_id": "string",
        "planet_type_id": "string",
        "name": "string",
        "surface_width": "int|null",
        "surface_height": "int|null",
        "surface_sector_count": "int|null",
        "buildable_surface_count": "int|null",
        "terraformable_surface_count": "int|null",
        "orbital_slot_count": "int|null",
        "surface_map": "array[surface_tile]|null",
        "deposits": "object",
        "atmosphere": "object",
        "habitability": "float",
        "base_attractiveness": "float",
        "image_key": "string|null"
      }
    },
    "surface_tiles": {
      "description": "Casillas internas de superficie de un planeta.",
      "primary_key": "tile_id",
      "fields": {
        "tile_id": "string celestial_body_id:sx:sy",
        "celestial_body_id": "string",
        "sx": "int",
        "sy": "int",
        "terrain_type_id": "string",
        "buildable": "bool",
        "terraformable": "bool",
        "building_id": "string|null",
        "resource_modifier": "object"
      }
    },
    "orbital_slots": {
      "description": "Slots/casillas orbitales del planeta.",
      "primary_key": "orbital_slot_id",
      "fields": {
        "orbital_slot_id": "string celestial_body_id:index",
        "celestial_body_id": "string",
        "index": "int",
        "structure_id": "string|null",
        "ship_ids": "array[string]",
        "buildable": "bool"
      }
    },
    "resource_nodes": {
      "description": "Fuentes recolectables del mapa.",
      "primary_key": "resource_node_id",
      "fields": {
        "resource_node_id": "string",
        "sector_id": "string",
        "resource_id": "string",
        "amount_current": "float",
        "amount_max": "float",
        "regen_per_tick": "float",
        "harvest_multiplier": "float",
        "requires_collector_type": "string|null",
        "depleted": "bool"
      }
    },
    "anomalies": {
      "description": "Fenómenos espaciales permanentes o temporales.",
      "primary_key": "anomaly_id",
      "fields": {
        "anomaly_id": "string",
        "sector_id": "string",
        "type": "string",
        "name": "string",
        "effects": "object",
        "is_temporary": "bool",
        "starts_tick": "int|null",
        "ends_tick": "int|null",
        "destination_sector_id": "string|null"
      }
    },
    "ship_positions": {
      "description": "Posición y estado de navegación de cada nave.",
      "primary_key": "ship_id",
      "fields": {
        "ship_id": "string",
        "sector_id": "string",
        "map_id": "int",
        "x": "int",
        "y": "int",
        "in_orbit": "bool",
        "orbiting_body_id": "string|null",
        "heading_dx": "int",
        "heading_dy": "int",
        "warp_factor": "int",
        "movement_state": "idle|moving|docked|orbit",
        "last_move_tick": "int"
      }
    },
    "colonies": {
      "description": "Colonias de jugadores/NPC.",
      "primary_key": "colony_id",
      "fields": {
        "colony_id": "string",
        "celestial_body_id": "string",
        "player_id": "string",
        "alliance_id": "string|null",
        "name": "string",
        "population_current": "int",
        "population_max": "int",
        "energy_current": "float",
        "energy_production": "float",
        "storage_current": "float",
        "storage_max": "float",
        "inventory": "object resource_id->amount",
        "surface_building_ids": "array[string]",
        "orbital_structure_ids": "array[string]"
      }
    },
    "structures": {
      "description": "Estaciones, bases, plataformas, puertas y construcciones orbitales.",
      "primary_key": "structure_id",
      "fields": {
        "structure_id": "string",
        "structure_type_id": "string",
        "sector_id": "string",
        "celestial_body_id": "string|null",
        "orbital_slot_id": "string|null",
        "owner_player_id": "string|null",
        "owner_alliance_id": "string|null",
        "hull_current": "float",
        "hull_max": "float",
        "shield_current": "float",
        "shield_max": "float",
        "active": "bool"
      }
    },
    "exploration": {
      "description": "Fog of war/cartografía conocida por jugador.",
      "primary_key": "player_id:sector_id",
      "fields": {
        "player_id": "string",
        "sector_id": "string",
        "knowledge_level": "0 unknown | 1 mapped | 2 scanned | 3 current",
        "first_discovered_tick": "int",
        "last_seen_tick": "int",
        "known_sector_type_id": "string|null",
        "known_body_id": "string|null",
        "known_owner_id": "string|null",
        "known_ship_signature": "object|null"
      },
      "indexes": [
        [
          "player_id",
          "last_seen_tick"
        ],
        [
          "player_id",
          "knowledge_level"
        ]
      ]
    },
    "sensor_contacts": {
      "description": "Contactos SRS/LRS temporales.",
      "primary_key": "contact_id",
      "fields": {
        "contact_id": "string",
        "observer_ship_id": "string",
        "target_sector_id": "string",
        "sensor_type": "SRS|LRS|cartography",
        "detection_tick": "int",
        "expires_tick": "int",
        "ship_count": "int|null",
        "slot_signature": "float|null",
        "energy_signature": "float|null",
        "object_count": "int|null",
        "confidence": "float"
      }
    },
    "routes": {
      "description": "Rutas planificadas.",
      "primary_key": "route_id",
      "fields": {
        "route_id": "string",
        "owner_player_id": "string",
        "name": "string",
        "map_id": "int",
        "waypoints": "array[{x,y}]",
        "calculated_path": "array[sector_id]",
        "total_flight_cost": "float",
        "avoid_hazards": "bool",
        "avoid_enemy_space": "bool",
        "created_tick": "int"
      }
    },
    "bookmarks": {
      "description": "Coordenadas guardadas por jugador.",
      "primary_key": "bookmark_id",
      "fields": {
        "bookmark_id": "string",
        "player_id": "string",
        "map_id": "int",
        "x": "int",
        "y": "int",
        "name": "string",
        "category": "string",
        "shared_with_alliance": "bool",
        "notes": "string"
      }
    },
    "territory_claims": {
      "description": "Control territorial sin obligar a que cada sector tenga propietario fijo.",
      "primary_key": "claim_id",
      "fields": {
        "claim_id": "string",
        "map_id": "int",
        "owner_type": "player|alliance|npc",
        "owner_id": "string",
        "shape": "rectangle|polygon|radius",
        "geometry": "object",
        "priority": "int",
        "starts_tick": "int",
        "ends_tick": "int|null"
      }
    },
    "map_events": {
      "description": "Eventos del mapa por tick.",
      "primary_key": "event_id",
      "fields": {
        "event_id": "string",
        "tick": "int",
        "event_type": "string",
        "sector_id": "string",
        "actor_id": "string|null",
        "payload": "object"
      }
    }
  },
  "navigation_rules": {
    "adjacent_move": "8 direcciones alrededor de la coordenada actual",
    "warp_factor": "Multiplicador de pasos en línea recta; el coste se acumula sector por sector.",
    "orbit_notation": "@X|Y",
    "flight_cost_formula": "ship.energy_travel_cost * sector.current_flight_cost * distance",
    "pathfinding": "A* recomendado, usando current_flight_cost como peso y penalización adicional por peligros/territorio hostil."
  },
  "sensor_rules": {
    "SRS": "Sector actual y objetos presentes; detalle alto.",
    "LRS": "Cuadrícula centrada en nave, radio = lrs_range. Devuelve firmas/objetos según sensores.",
    "cartography": "Consulta del mapa conocido por el jugador; no equivale a visión en tiempo real.",
    "fog_of_war": true
  },
  "api_queries_recommended": [
    "get_sector(map_id,x,y)",
    "get_map_window(map_id,center_x,center_y,radius,player_id)",
    "get_lrs(ship_id)",
    "get_srs(ship_id)",
    "move_ship(ship_id,dx,dy,warp_factor)",
    "plan_route(ship_id,destination_x,destination_y)",
    "save_bookmark(player_id,map_id,x,y,name)",
    "get_colonizable_bodies(region_id)",
    "get_region_activity(region_id)"
  ]
}